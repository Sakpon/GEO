{
  "name": "martics-geo-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "martics.co — GEO Citation Tracker (MVP, Phases 0–2): Thai-native AI Share-of-Voice + citation tracking on a Cloudflare Worker.",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply martics --local",
    "db:migrate:remote": "wrangler d1 migrations apply martics --remote",
    "db:seed:local": "wrangler d1 execute martics --local --file=./seeds/thedent.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.6",
    "wrangler": "^3.90.0"
  }
}
